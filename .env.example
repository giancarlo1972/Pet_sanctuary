# Database Configuration
DATABASE_URL=postgresql://username:password@host:port/database
POSTGRES_HOST=pet-sanctuary-db.postgres.database.azure.com
POSTGRES_PORT=5432
POSTGRES_DB=pet_sanctuary
POSTGRES_USER=petsanctuaryadmin
POSTGRES_PASSWORD=your_password_here

# Azure Storage
AZURE_STORAGE_ACCOUNT_NAME=petsanctuarystorage
AZURE_STORAGE_ACCOUNT_KEY=your_storage_key_here
AZURE_STORAGE_CONTAINER_NAME=pet-images

# App Configuration
EXPO_PUBLIC_API_URL=https://your-api-domain.com
EXPO_PUBLIC_WEBSITE_URL=https://your-website-domain.com
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id

# Push Notifications (Optional)
EXPO_PUBLIC_PUSH_TOKEN=your-expo-push-token

# Analytics (Optional)
EXPO_PUBLIC_ANALYTICS_ID=your-analytics-id