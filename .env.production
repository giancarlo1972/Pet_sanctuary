# Production Environment Variables for Pet Sanctuary

# Database Configuration (Azure PostgreSQL)
DATABASE_URL=postgresql://petsanctuaryadmin:PetSanctuary2024!@pet-sanctuary-db.postgres.database.azure.com:5432/pet_sanctuary?sslmode=require
POSTGRES_HOST=pet-sanctuary-db.postgres.database.azure.com
POSTGRES_PORT=5432
POSTGRES_DB=pet_sanctuary
POSTGRES_USER=petsanctuaryadmin
POSTGRES_PASSWORD=PetSanctuary2024!

# Azure Storage (Create this next)
AZURE_STORAGE_ACCOUNT_NAME=petsanctuarystorage
AZURE_STORAGE_ACCOUNT_KEY=your_storage_key_here
AZURE_STORAGE_CONTAINER_NAME=pet-images

# App Configuration
EXPO_PUBLIC_API_URL=https://pet-sanctuary.azurewebsites.net
EXPO_PUBLIC_WEBSITE_URL=https://pet-sanctuary.azurewebsites.net
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id

# Security
JWT_SECRET=your-super-secure-jwt-secret-here
ENCRYPTION_KEY=your-encryption-key-here

# Push Notifications
EXPO_PUBLIC_PUSH_TOKEN=your-expo-push-token

# Analytics
EXPO_PUBLIC_ANALYTICS_ID=your-analytics-id